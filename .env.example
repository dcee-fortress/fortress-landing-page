# Fortress Vision backend — copy to `.env` and fill in.
# NEVER put this key in the React app or commit `.env`.

GEMINI_API_KEY=your_gemini_api_key_here
# Vision model (default gemini-3.5-flash-lite). gemini-3.8-flash-lite-tts is audio-only.
GEMINI_MODEL=gemini-3.5-flash-lite
VISION_PORT=8787

# Live fortress-zw site (website + PWA + shared API for apps). Same uploads everywhere.
VITE_FORTRESS_ORIGIN=https://fortress-zw.vercel.app
# Native / Electron builds should point at that same origin so the live feed matches the website.
VITE_API_BASE=https://fortress-zw.vercel.app
